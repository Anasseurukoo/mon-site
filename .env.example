# Public build-time configuration
NEXT_PUBLIC_SITE_URL=
# Leave blank for the deployed BBA AI endpoint. Set explicitly only for mock mode.
NEXT_PUBLIC_BBA_AI_ENDPOINT=

# Supabase Edge Function secrets only - never add these to a NEXT_PUBLIC_ variable,
# GitHub Pages build variable, client bundle, or static export.
GEMINI_API_KEY=
SUPABASE_DB_URL=
BBA_AI_RATE_LIMIT_SECRET=

# Supabase Edge Function server-side configuration (not secrets).
BBA_AI_RATE_LIMIT_WINDOW_SECONDS=600
BBA_AI_RATE_LIMIT_MAX_REQUESTS=10
BBA_AI_GLOBAL_RATE_LIMIT_MAX_REQUESTS=120
BBA_AI_ALLOW_LOCALHOST=false
BBA_AI_ENABLE_GEMINI_35_FALLBACK=false
