{
  "name": "builtbyanas-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BuiltByAnas V2 — personal engineering portfolio",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "node scripts/mock-bba-ai.mjs",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:pricing": "node scripts/test-pricing.mjs",
    "test:respect-mode": "node --experimental-strip-types scripts/test-respect-mode.ts",
    "test:chat-history": "node --experimental-strip-types scripts/test-chat-history.ts",
    "test:safe-markdown": "node --experimental-strip-types scripts/test-safe-markdown.ts",
    "test:build-intent": "node --experimental-strip-types scripts/test-build-intent.ts",
    "test:bba-ai-core": "node --experimental-strip-types scripts/test-bba-ai-core.ts",
    "test:bba-ai-provider": "node --experimental-strip-types scripts/test-bba-ai-provider.ts",
    "test:bba-ai-client": "node scripts/test-bba-ai-client.mjs",
    "test:bba-ai-static": "node scripts/test-bba-ai-static.mjs",
    "test:rate-limit-model": "node scripts/test-rate-limit-model.mjs",
    "test:bba-ai": "npm run test:respect-mode && npm run test:chat-history && npm run test:safe-markdown && npm run test:build-intent && npm run test:bba-ai-core && npm run test:bba-ai-provider && npm run test:bba-ai-client && npm run test:rate-limit-model && npm run test:bba-ai-static",
    "validate:export": "node scripts/validate-static-export.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "~9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
